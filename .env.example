# Django
SECRET_KEY=django-insecure-CHAVE-
DEBUG=True
ALLOWED_HOSTS=
COOKIE_SECURE=False

# CORS (separar múltiplas origens por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PostgreSQL
POSTGRES_DB=gestao_fisio
POSTGRES_USER=seu_usuario_aqui
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend URL (para links em e-mails)
FRONTEND_URL=http://localhost:4200

# Armazenamento de mídia (fotos de perfil)
# False (padrão): salva em ./media no disco local. True: salva no Cloudflare R2.
USE_S3=False
# Obrigatórias quando USE_S3=True:
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_DOMAIN=pub-xxxxxxxx.r2.dev

# E-mail (em dev, o padrão é console — imprime no terminal)
# Em produção: SMTP do Resend, com o domínio gestao-fisio.com verificado (DKIM/SPF na Cloudflare)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_sua_api_key
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Gestão Fisio <nao-responda@gestao-fisio.com>